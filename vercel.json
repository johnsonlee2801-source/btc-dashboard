{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "btc.zhixingshe.cc"
        }
      ],
      "destination": "https://btc.flowhunt.net/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "stock.zhixingshe.cc"
        }
      ],
      "destination": "https://stock.flowhunt.net/$1",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "stock.flowhunt.net"
        }
      ],
      "destination": "/robots-stock.txt",
      "permanent": false
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "stock.flowhunt.net"
        }
      ],
      "destination": "/sitemap-stock.xml",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "stock.flowhunt.net"
        }
      ],
      "destination": "/stock",
      "permanent": false
    },
    {
      "source": "/og-image.png",
      "destination": "/og-image.jpg",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/eth",
      "destination": "/eth.html"
    },
    {
      "source": "/distribution-radar",
      "destination": "/distribution-radar.html"
    },
    {
      "source": "/halving",
      "destination": "/halving.html"
    },
    {
      "source": "/stock",
      "destination": "/stock.html"
    },
    {
      "source": "/stock/",
      "destination": "/stock.html"
    },
    {
      "source": "/stock-en",
      "destination": "/stock-en.html"
    },
    {
      "source": "/stock-en/",
      "destination": "/stock-en.html"
    },
    {
      "source": "/stock/nvda-risk",
      "destination": "/stock-nvda-risk.html"
    },
    {
      "source": "/stock/nvda-risk/",
      "destination": "/stock-nvda-risk.html"
    },
    {
      "source": "/stock/tsla-risk",
      "destination": "/stock-tsla-risk.html"
    },
    {
      "source": "/stock/tsla-risk/",
      "destination": "/stock-tsla-risk.html"
    },
    {
      "source": "/stock/pltr-risk",
      "destination": "/stock-pltr-risk.html"
    },
    {
      "source": "/stock/pltr-risk/",
      "destination": "/stock-pltr-risk.html"
    },
    {
      "source": "/stock/amd-risk",
      "destination": "/stock-amd-risk.html"
    },
    {
      "source": "/stock/amd-risk/",
      "destination": "/stock-amd-risk.html"
    },
    {
      "source": "/stock/smci-risk",
      "destination": "/stock-smci-risk.html"
    },
    {
      "source": "/stock/smci-risk/",
      "destination": "/stock-smci-risk.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, Content-Type, X-Device-Id"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/price-alert",
      "schedule": "0 0 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
